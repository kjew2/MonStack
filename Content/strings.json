    {
      "key": "stat.hp.name",
      "text": "Health"
    },
    {
      "key": "stat.hp.label",
      "text": "max HP"
    },
    {
      "key": "stat.hp.desc",
      "text": "Max HP in battle is HP x {MON_HP_PER_POINT}. Skills that scale with HP use max HP."
    },
    {
      "key": "stat.hp.now",
      "text": "{max_hp} max HP"
    },
    {
      "key": "stat.str.name",
      "text": "Strength"
    },
    {
      "key": "stat.str.desc",
      "text": "Physical damage. The basic attack hits for {BASIC_ATTACK_POWER} x the higher of STR and INT, and STR-scaled skills deal physical damage. Physical hits can be dodged (DEX) and the target's DEF reduces them."
    },
    {
      "key": "stat.str.now",
      "text": "Basic attack: {basic} damage before defences ({basic_type})"
    },
    {
      "key": "stat.int.name",
      "text": "Intelligence"
    },
    {
      "key": "stat.int.desc",
      "text": "Magical damage. INT-scaled skills deal magical damage, which cannot be dodged and which the target's WIS reduces. The basic attack uses INT instead of STR when INT is higher, and is then magical."
    },
    {
      "key": "stat.int.now",
      "text": "Basic attack: {basic} damage before defences ({basic_type})"
    },
    {
      "key": "stat.wis.name",
      "text": "Wisdom"
    },
    {
      "key": "stat.wis.desc",
      "text": "Magic defence: magical damage taken is multiplied by {MON_DEF_K} / ({MON_DEF_K} + WIS), so {MON_DEF_K} WIS halves it. WIS also sets the amount of WIS-scaled heals and shields."
    },
    {
      "key": "stat.wis.now",
      "text": "Takes {wis_taken:pct} of magical damage"
    },
    {
      "key": "stat.dex.name",
      "text": "Dexterity"
    },
    {
      "key": "stat.dex.desc",
      "text": "Dodging physical hits. Dodge chance is {MON_EVADE_BASE:pct} plus {MON_EVADE_PER_DEX:pct} per point of DEX above the attacker's (minus when below), from 0 to {MON_EVADE_CAP:pct}. DEX also makes the unit's own physical hits harder to dodge. Magical hits cannot be dodged."
    },
    {
      "key": "stat.dex.now",
      "text": "Dodges {evade:pct} of {foe}'s physical hits; {foe} dodges {foe_evade:pct} of the physical hits it takes"
    },
    {
      "key": "stat.def.name",
      "text": "Defence"
    },
    {
      "key": "stat.def.desc",
      "text": "Physical defence: physical damage taken is multiplied by {MON_DEF_K} / ({MON_DEF_K} + DEF), so {MON_DEF_K} DEF halves it."
    },
    {
      "key": "stat.def.now",
      "text": "Takes {def_taken:pct} of physical damage"
    },
    {
