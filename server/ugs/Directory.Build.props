<Project>
  <!-- Same layout as src/: build output goes to <repo>/build/, which is git-ignored (MonStackBuildSuffix: see src/Directory.Build.props). -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../build/obj$(MonStackBuildSuffix)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../build/bin$(MonStackBuildSuffix)/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
