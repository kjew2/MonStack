<Project>
  <!-- Keep dotnet build output out of the source folders. Output lands in <repo>/build/, which is git-ignored.
       MonStackBuildSuffix (empty by default) gives a second SDK its own folders: check.sh builds the Cloud Code module's tests
       with .NET 10 as build/obj-net10/ and build/bin-net10/, so the .NET 8 build's restore state is never shared. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../build/obj$(MonStackBuildSuffix)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../build/bin$(MonStackBuildSuffix)/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
