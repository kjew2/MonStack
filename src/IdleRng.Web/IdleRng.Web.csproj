<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Browser host for the existing C# core: IdleRng.Web.Engine exposes the bridge in web/wasm/BRIDGE.md via [JSExport].
       Build with web/wasm/build.sh (it also produces build/content-pack.json, embedded below as a fallback). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>IdleRng.Web</RootNamespace>
    <AssemblyName>IdleRng.Web</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <WasmDebugLevel>0</WasmDebugLevel>
    <WasmNativeStrip>true</WasmNativeStrip>
    <CompressionEnabled>false</CompressionEnabled>
    <BlazorEnableCompression>false</BlazorEnableCompression>
    <ContentPackPath>$(MSBuildThisFileDirectory)../../build/content-pack.json</ContentPackPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../IdleRng.Sim/IdleRng.Sim.csproj" />
    <ProjectReference Include="../IdleRng.Runtime/IdleRng.Runtime.csproj" />
    <!-- Only for Engine.GoldenVectors (the wasm golden check, BRIDGE.md): the same vector generators the bot CLI's `golden` verb runs. -->
    <ProjectReference Include="../IdleRng.Bots/IdleRng.Bots.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- IdleRng.Bots is a console exe used here as a library (its Main never runs in the browser); allow the reference (NETSDK1150). -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- Newtonsoft.Json (save serializer) reflects over AccountState and RunState; keep these assemblies whole instead of trimming members. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="IdleRng.Sim" />
    <TrimmerRootAssembly Include="IdleRng.Runtime" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(ContentPackPath)')">
    <EmbeddedResource Include="$(ContentPackPath)" LogicalName="content-pack.json" />
  </ItemGroup>
</Project>
