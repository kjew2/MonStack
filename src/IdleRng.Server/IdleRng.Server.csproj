<Project Sdk="Microsoft.NET.Sdk">
  <!-- The account server core (specs/27 section 10 step 2): Open and Commit over an IAccountStore. netstandard2.1 so the UGS
       Cloud Code module (net10.0, step 4) and the WebAssembly page's local test server (step 3) can both reference it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>IdleRng.Server</RootNamespace>
    <AssemblyName>IdleRng.Server</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IdleRng.Runtime/IdleRng.Runtime.csproj" />
    <ProjectReference Include="../IdleRng.Sim/IdleRng.Sim.csproj" />
  </ItemGroup>
</Project>
